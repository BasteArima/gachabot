# Telegram Bot Token (get it from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord Bot Token
DISCORD_TOKEN=your_discord_token_here

# Service owner's Discord user id — gates owner-only Discord commands (/spawnnow).
# Get it: Discord → Settings → Advanced → Developer Mode → right-click your profile → Copy User ID.
ADMIN_DISCORD_ID=

# Discord OAuth / Activity (web login & embedded app — not the bot gateway).
# Needed only for Discord web/Activity login (HTTP slice C). Leave blank otherwise.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT=https://your-domain/api/auth/discord/callback

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=gachabot
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Settings
REQUIRE_18_PLUS_CONFIRM=true

COOLDOWN_HOURS=3

# Allow players to receive cards they already own. Set to false for a
# "collect them all, no duplicates" mode (new duplicates stop dropping; existing
# ones remain and stay craftable while ENABLE_CRAFT is true).
ENABLE_DUPLICATES=true

# Whether crafting is available. Independent of ENABLE_DUPLICATES, so players can
# still burn existing duplicates while duplicate drops are off.
ENABLE_CRAFT=true

ADMIN_TELEGRAM_ID=your_admin_telegram_id
ADMIN_TG_SUGGESTS_GROUP_ID=your_group_id
ADD_BOT_TO_GROUP_LINK=https://t.me/YOUR_BOT_bot?startgroup=true

START_BANNER_URL=https://site/banner.webp

ADMIN_TG_BACKUP_GROUP_ID=your_group_id
# Example: Every 03:10
BACKUP_TIME_HOUR=3
BACKUP_TIME_MINUTE=10

# Web/API layer (TMA, Discord Activity, browser). The Go service serves /api/*
# and (optionally) the built SPA from HTTP_STATIC_DIR. Put it behind your HTTPS
# reverse proxy (Mini App requires HTTPS).
HTTP_PORT=8080
# Directory with the built frontend (dist). In Docker this is baked into the
# image (/root/web) by the Dockerfile — set it only for local non-Docker runs.
HTTP_STATIC_DIR=
# Public HTTPS URL of the web app (used for buttons/redirects later).
WEB_APP_URL=https://your-domain
# Local dev only: treat unauthenticated requests as the admin user. NEVER in prod.
DEV_ALLOW_NO_AUTH=false

# Frontend build-time vars (baked into the SPA when the image is built).
# Bot username (no @) for the browser Telegram Login Widget; Discord app client id.
VITE_TG_BOT_USERNAME=
VITE_DISCORD_CLIENT_ID=

# Card art storage. The art is served from a separate host, so the admin panel
# needs both the public url it is served under and a way to write files to it.
# Files are prepared in the browser (crop + frame on a canvas) and only stored
# here; the server does no image processing.
#
# Public url prefix of the art host — the panel builds card image urls from it.
ART_PUBLIC_BASE=https://api.example.com
#
# Driver: ART_SFTP_HOST set → sftp; else ART_LOCAL_DIR → a plain directory
# (local development, or a fallback if SSH is unavailable); neither → uploads
# are disabled and the panel says so.
ART_LOCAL_DIR=
ART_SFTP_HOST=api.example.com
ART_SFTP_USER=
ART_SFTP_PASSWORD=
# Directory the art host serves from, e.g. /var/www/api_files — the panel writes
# <root>/cards/<Rarity>/<slug>.webp and <root>/cards_framed/<Rarity>/<slug>.webp.
ART_SFTP_ROOT=/var/www/api_files
# The server's host key, REQUIRED with password auth: without it the password
# would be handed to whatever answers at that address. Take it once with
#   ssh-keyscan -t ed25519 api.example.com
# and paste the whole line, or paste a "SHA256:…" fingerprint instead.
ART_SFTP_HOST_KEY=
